      "updateFormInfo": {
        "info": {
          "description": "Hi, I'm a Kepler student building Unipicks: student deals from food places near Kigali campus. You order ahead, pay with MoMo or Airtel Money, and pick up without waiting in line.\n\n7 quick questions, about 1 minute. Most are just one tap. No name needed. Murakoze."
        },
        "updateMask": "description"
      }
    },
    {
      "updateSettings": {
