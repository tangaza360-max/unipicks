VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_PAYPACK_BASE_URL=https://api.paypack.io/sandbox
# Sentry DSN (public). Only production builds send crash reports.
VITE_SENTRY_DSN=
# Phone alerts (Web Push): the PUBLIC VAPID key (public by design). Empty = alerts card hidden.
# The private key is an Edge Function secret (VAPID_PRIVATE_KEY), never a VITE_* variable.
VITE_VAPID_PUBLIC_KEY=
# Support address shown in the app. Empty = unipicks.team@gmail.com (until a domain is bought).
VITE_SUPPORT_EMAIL=
# Support WhatsApp number shown on the Help page, e.g. 0788123456 or +250788123456. Empty = no WhatsApp button.
VITE_SUPPORT_WHATSAPP=
# Unipicks' own registration line on receipts, e.g. "Unipicks Ltd · RDB/TIN 123456789". Empty = hidden.
VITE_UNIPICKS_REGISTRATION=

# Paypack keys belong in Supabase Edge Function secrets, never in VITE_* variables.
# PAYPACK_PUBLIC_KEY=your-paypack-public-key
# PAYPACK_SECRET_KEY=your-paypack-secret-key
# PAYPACK_WEBHOOK_SECRET=your-paypack-webhook-secret
